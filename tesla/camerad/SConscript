Import('env', 'arch', 'messaging', 'common', 'gpucommon', 'visionipc', 'cereal', 'webcam')

libs = ['m', 'pthread', common, 'jpeg', 'json', cereal, 'OpenCL', messaging, 'czmq', 'zmq', 'capnp', 'kj', 'capnp_c', visionipc, gpucommon]

if arch == "aarch64":
  libs += ['gsl', 'CB', 'adreno_utils', 'EGL', 'GLESv3', 'cutils', 'ui', 'usb-1.0']
  # the phone's cameras (camera_qcom.c) plus the OPTIONAL external C920 road camera (camera_ext_c920.cc + the vendored libuvc): chosen at run time by /data/camera_source, default = the phone's camera
  cameras = ['cameras/camera_qcom.c', 'cameras/camera_ext_c920.cc'] + ['libuvc/src/' + f for f in ['ctrl.c', 'ctrl-gen.c', 'device.c', 'diag.c', 'frame.c', 'init.c', 'misc.c', 'stream.c']]
  env = env.Clone()
  env.Append(CPPPATH = ['#selfdrive/camerad/libuvc/include', '/data/data/com.termux/files/usr/include/libusb-1.0', '/usr/include/libusb-1.0'])
  # OPTIONAL H.264 input for the C920 (cameras/camera_h264.h, opt-in at run time with /data/camera_format). It is compiled in ONLY if the phone's ffmpeg headers exist AND a trial
  # compile of that header succeeds right here; libavcodec itself is never linked (it is loaded at run time, only when H.264 is selected). Any doubt = camerad is built exactly
  # as before, MJPEG only.
  try:
    import os
    avc_inc = os.environ.get('EXT_AVCODEC_INC', '/system/comma/usr/include')
    if os.path.exists(avc_inc + '/libavcodec/avcodec.h') and os.path.exists(avc_inc + '/libavutil/frame.h'):
      trial = env.Clone()
      trial.Append(CPPPATH = [avc_inc])
      conf = Configure(trial)
      trial_src = '#define EXT_WANT_AVCODEC 1\n#include "%s"\nint main() { h264::Decoder d; char w[8]; return d.open(w, sizeof w) ? 1 : 0; }\n' % os.path.join(Dir('#selfdrive/camerad/cameras').abspath, 'camera_h264.h')
      trial_ok = conf.TryCompile(trial_src, '.cc')
      conf.Finish()
      if trial_ok:
        env.Append(CPPPATH = [avc_inc], CXXFLAGS = ['-DEXT_WANT_AVCODEC'])
        print("camerad: H.264 input is built in (opt-in: /data/camera_format = h264)")
      else:
        print("camerad: H.264 input NOT built in (the trial compile failed): MJPEG only")
    else:
      print("camerad: H.264 input NOT built in (no ffmpeg headers in %s): MJPEG only" % avc_inc)
  except Exception as e:
    print("camerad: H.264 input NOT built in (%s): MJPEG only" % e)
  # OPTIONAL stop-sign/traffic-light detection (cameras/sign_detect.cc, opt-in at run time with
  # /data/sign_detect_on - see SIGN_DETECT.md). Same philosophy as the H.264 block above: compiled in
  # ONLY if OpenCV headers/libs exist AND a trial compile succeeds right here. Any doubt = camerad is
  # built exactly as before, with no sign/light detection code path at all.
  try:
    cv_inc = os.environ.get('EXT_OPENCV_INC', '/system/comma/usr/include/opencv4')
    cv_lib_names = ['opencv_core', 'opencv_imgproc']
    if os.path.exists(cv_inc + '/opencv2/opencv.hpp'):
      trial = env.Clone()
      trial.Append(CPPPATH = [cv_inc], LIBS = cv_lib_names)
      conf = Configure(trial)
      trial_src = '#include "%s"\nint main() { cv::Mat m(2, 2, CV_8UC3); return detect_signs(m).stop_sign ? 1 : 0; }\n' % os.path.join(Dir('#selfdrive/camerad/cameras').abspath, 'sign_detect.h')
      trial_ok = conf.TryCompile(trial_src, '.cc') and conf.TryLink(trial_src, '.cc')
      conf.Finish()
      if trial_ok:
        env.Append(CPPPATH = [cv_inc], CXXFLAGS = ['-DEXT_WANT_SIGN_DETECT'])
        libs += cv_lib_names
        cameras += ['cameras/sign_detect.cc', 'cameras/sign_detect_io.cc']
        print("camerad: sign/light detection is built in (opt-in: touch /data/sign_detect_on)")
      else:
        print("camerad: sign/light detection NOT built in (the trial compile/link failed): unchanged camerad")
    else:
      print("camerad: sign/light detection NOT built in (no OpenCV headers in %s): unchanged camerad" % cv_inc)
  except Exception as e:
    print("camerad: sign/light detection NOT built in (%s): unchanged camerad" % e)
elif arch == "larch64":
  libs += []
  cameras = ['cameras/camera_qcom2.c']
elif arch == "jarch64":
    libs += ['opencv_core', 'opencv_highgui', 'opencv_video', 'opencv_imgproc', 'opencv_videoio']
    cameras = ['cameras/camera_webcam.cc']
    env = env.Clone()
    env.Append(CXXFLAGS = '-DWEBCAM')
    env.Append(CFLAGS = '-DWEBCAM')
    #env.Append(CPPPATH = '/usr/local/include/opencv4')
else:
  if webcam:
    libs += ['opencv_core', 'opencv_highgui', 'opencv_imgproc', 'opencv_videoio']
    cameras = ['cameras/camera_webcam.cc']
    env = env.Clone()
    env.Append(CXXFLAGS = '-DWEBCAM')
    env.Append(CFLAGS = '-DWEBCAM')
    env.Append(CPPPATH = '/usr/local/include/opencv4')
  else:
    libs += []
    cameras = ['cameras/camera_frame_stream.cc']

env.SharedLibrary('snapshot/visionipc',
  ["#selfdrive/common/visionipc.c", "#selfdrive/common/ipc.c"])

env.Program('camerad', [
    'main.cc',
    'transforms/rgb_to_yuv.c',
    cameras,
  ], LIBS=libs)
